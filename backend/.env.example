# AcoustID application/client API key (get one free at https://acoustid.org/new-application)
# Keep this on the server only — never expose it to frontend JS.
ACOUSTID_CLIENT_KEY=your_acoustid_client_key_here

# Port the backend listens on (Render sets this automatically in production)
PORT=3000

# Comma-separated list of origins allowed to call this API (your Vercel/GitHub Pages frontend URL)
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Max upload size in MB
MAX_UPLOAD_MB=50

# Path to fpcalc binary if not on PATH (optional)
FPCALC_PATH=fpcalc

# Path to ffmpeg binary if not on PATH (optional)
FFMPEG_PATH=ffmpeg
